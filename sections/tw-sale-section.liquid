          {% if st.left_image != blank %}
          <img loading="lazy" class="zs left" height="92" width="73" alt=""
            src="{{ st.left_image | image_url: width: '73'}}"
            srcset="{{ st.left_image | image_url:width: '73'  }} 73w">
           {% endif %}
          <h2>{{ st.pro_title }}</h2>
           {% if st.right_image != blank %}
          <img loading="lazy" class="zs " height="92" width="73" alt=""
            src="{{ st.right_image | image_url:  width: '73'  }}"
            srcset="{{ st.right_image | image_url: width: '73'  }} 73w">
           {% endif %}
        </div>
        <p>{{ st.pro_desc }}</p>
      </div>

      <div>
  <div class=" {{ container }} section-full">
         <div class="bls__product-with-banner">
          {%- render 'sale-grid-layout' | st: st | | more_row: more_row -%}
        </div>
        </div>
      </div>
    </div>
