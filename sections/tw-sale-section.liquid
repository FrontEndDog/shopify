              url(https://cdn.shopify.com/s/files/1/0559/2321/2486/files/decor_goods_top.png?v=1730187162) top 9vw right 16vw / auto no-repeat,
              var(--bg-gradient);
          }

          .lt-bf-24 .lt-goods .card .card-content .btns {
            flex-direction: row;
          }

          .lt-bf-24 .lt-goods .card .card-content .btns .lt-copy,
          .lt-bf-24 .lt-goods .card .card-content .btns .lt-shop {
            height: 34px;
          }
        }

        @media (min-width: 1024px) {
          .t4s-wrapper__custom .lt-bf-24 .t4s-container {
            --wrapper-mw: 1560px;
          }

          .lt-bf-24 .lt-goods .card {
            --btn-fz: clamp(12px, 0.8333vw, 16px);
            font-size: var(--btn-fz);
          }

          .lt-bf-24 .lt-goods .card .card-content {
            padding: 1.5em;
          }

          .lt-bf-24 .lt-goods .card .card-content .content-wapper {
            gap: 1em;
          }

          .lt-bf-24 .lt-goods .card .card-content h5 {
            font-size: 1em;
          }

          .lt-bf-24 .lt-goods .card .card-content .price {
            font-size: 1.5em;
          }

          .lt-bf-24 .lt-goods .card .card-content .price .origin {
            font-size: 0.75em;
          }

          .lt-bf-24 .lt-goods .card .card-content .btns {
            gap: 1.5em;
          }

          .lt-bf-24 .lt-copy .code {
            font-size: 1em;
          }
        }

        @media (min-width: 1280px) {
          .lt-bf-24 .lt-title {
            font-size: 26.18px;
          }

          .lt-bf-24 .lt-goods .card .card-content .btns .lt-copy,
          .lt-bf-24 .lt-goods .card .card-content .btns .lt-shop {
            height: 44px;
          }
        }
      </style>

