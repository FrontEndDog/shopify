        <script type="text/javascript">
          (function () {
            // 设置缩放比例
            function setScale() {
              var el = $('#clock-wapper');
              var containerWidth = el.width();
              var elWidth = el.find('.clock-container').outerWidth();
              var scale = containerWidth / elWidth;
              if (scale > 1) return;
              el[0].style.setProperty('--scale', scale * 0.9);
            }

            // 初始化倒计时
            function init() {
              setScale();
const clockElement = document.getElementById("clock-wapper");
const countdownTime = clockElement.getAttribute("data-time");
              // 使用 dayjs 计算倒计时
              let targetDate = dayjs(countdownTime).tz('Asia/Shanghai'); // 设置目标时间
              let now = dayjs().tz('Asia/Shanghai'); // 获取当前时间
              let diff = targetDate.diff(now, 'seconds'); // 计算目标时间与当前时间的差值，单位是秒

              // 如果目标时间已经过去，则设置倒计时为 0
              diff = diff < 0 ? 0 : diff;

              // 使用 FlipClock 创建倒计时
              clock = $('.clock').FlipClock(diff, {
                clockFace: 'HourlyCounter',
                countdown: true,
                autoStart: true,
                callbacks: {
                  start: function () {
                    $('.lt-countdown .clock-wapper').css('visibility', 'visible'); // 显示倒计时容器
                  }
                }
              });
            }

            // 初始化倒计时
            init();

            // 监听窗口大小变化，重新计算缩放比例
            window.addEventListener('resize', setScale);
          })();
        </script>
