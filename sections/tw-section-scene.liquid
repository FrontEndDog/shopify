 <style>
.etsy-everyday__listing{
  width: 106px;
}
:root{
    --clg-typography-pal-weight-600: 600;
    --clg-typography-pal-weight-500: 500;
    --clg-typography-pal-weight-400: 400;
    --clg-typography-pal-weight-300: 300;
    --clg-typography-pal-weight-200: 200;
    --clg-effect-sem-shadow-elevation-4: 0px 1px 5px 0px #0000004d, 0px 5px 20px 6px #00000026;
    --clg-effect-sem-shadow-elevation-3: 0px 1px 3px 0px #0000004d, 0px 4px 8px 3px #00000026;
    --clg-effect-sem-shadow-elevation-2: 0px 1px 2px 0px #0000004d, 0px 2px 6px 2px #00000026;
    --clg-effect-sem-shadow-elevation-1: 0px 1px 2px 0px #0000004d, 0px 1px 3px 1px #00000026;
    --clg-effect-pal-curve-symmetrical-out: cubic-bezier(.5,0,1,1);
    --clg-effect-pal-curve-long-out: cubic-bezier(.3,0,1,1);
    --clg-effect-pal-curve-symmetrical-in: cubic-bezier(0,0,.5,1);
    --clg-effect-pal-curve-long-in: cubic-bezier(0,0,0,1);
    --clg-effect-pal-curve-linear: cubic-bezier(0,0,1,1);
    --clg-effect-pal-curve-symmetrical: cubic-bezier(.5,0,.5,1);
    --clg-effect-pal-curve-long-tail: cubic-bezier(.3,0,0,1);
}
.etsy-everyday__listing{
  color: inherit;
    font: inherit;
    cursor: pointer;
    text-align: left;
    -webkit-tap-highlight-color: #0000;
    -webkit-appearance: none;
    cursor: pointer;
    z-index: 10;
    background: 0 0;
    border: none;
    outline: none;
    max-width: 100%;
    text-decoration: none;
    display: inline-block;
    position: relative;
    height: fit-content;
    transition: box-shadow .3s ease-in-out;
}
.etsy-everyday__listing::before{
  position: absolute;
  content: "";
    opacity: 0;
    box-shadow: var(--clg-effect-sem-shadow-elevation-3,0px 1px 3px 0px #0000004d,0px 4px 8px 3px #00000026);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    z-index: -1;
    top: 3px;
    bottom: 3px;
    left: 3px;
    right: 3px;
    border-radius: 18px;
    transition: opacity .15s ease-out, top .2s cubic-bezier(.345,.115,.135,1.42), bottom .15s ease-out, left .2s cubic-bezier(.345,.115,.135,1.42), right .15s ease-out;
}
  @media screen and (min-width: 750px) {
    .etsy-everyday__listing{
  width: 160px;
}
.etsy-everyday__listing:hover:before {
    opacity: 1;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
}
.etsy-everyday__listing:hover:before{
    top: -8px;
    bottom: -8px;
    left: -8px;
    right: -8px;
}
  }
     .section-{{ section.id }}-block {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-block {
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
   .scence_swiper{
    max-width:900px;
  }
  </style>
<div class="tw-px-1.5 section-{{ section.id }}-block">
  <div class="tw-mx-auto tw-max-w-[1400px] tw-px-1.5">
    {% if section.settings.title %}
      <h2 class="tw-text-[27px] tw-leading-[1.3] tw-font-medium tw-mb-[18px] tw-text-left md:tw-text-center">
        {{ section.settings.title | escape }}
      </h2>
    {% endif %}
    <div class="tw-grid tw-grid-cols-2 md:tw-grid-cols-{{ section.blocks.size }} tw-gap-5 md:tw-gap-[30px] md:tw-w-fit tw-mx-auto tw-pt-4 tw-px-1.5">
      {% for block in section.blocks %}
        {% if block.settings.link or block.settings.image or block.settings.title %}
          <div class="etsy-everyday__li tw-flex tw-justify-center" {{ block.shopify_attributes }}>
            <div class="etsy-everyday__listing tw-rounded-xl tw-h-fit">
              {% if block.settings.link %}
                <a href="{{ block.settings.link | escape }}" class="shopping-window-interior">
              {% else %}
                <div class="shopping-window-interior">
              {% endif %}
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 600 | image_tag: widths: '200, 600',
                    class: 'tw-object-cover tw-w-full tw-h-full tw-bg-[#eaeaea] tw-mb-1.5 tw-rounded-full',
                    loading: 'lazy'
                  }}
                {% endif %}
                {% if block.settings.title %}
                  <p
                    class="tw-text-center tw-text-base tw-leading-tight tw-text-[#222] first-letter:tw-uppercase"
                    title=""
                  >
                    {{ block.settings.title | escape }}
                  </p>
                {% endif %}
              {% if block.settings.link %}
                </a>
              {% else %}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom 场景板块",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Discover special gifts for every occasion"
    }, {
      "type": "header",
      "content": "外边距"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "top",
      "default": 24
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "bottom",
      "default": 0
    }, {
      "type": "header",
      "content": "内边距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "bottom",
      "default": 48
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "gift_card",
      "name": "Gift Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image Alt Text",
          "default": "Gifts for Kids"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Gift Title",
          "default": "Gifts for Kids"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"

        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom 场景板块",
      "blocks": [
        {
          "type": "gift_card"
        },
        {
          "type": "gift_card"
        },
        {
          "type": "gift_card"
        },
        {
          "type": "gift_card"
        },
        {
          "type": "gift_card"
        }
      ]
    }
  ]
}
{% endschema %}