<style>
   .wt-text-truncate--multi-line {
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        margin-top: 12px;
        display: -webkit-box;
        overflow: hidden;
      }
      .occasion-card:before {
        content: "";
        opacity: 0;
        z-index: -1;
        transition: opacity 0.15s ease-out;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
      }
      .etsy-icon.wt-icon--smaller,
      .wt-icon.wt-icon--smaller ,.wt-icon svg{
        width: 18px;
        height: 18px;
      }
      .etsy-icon,
      .wt-icon  {
        fill: currentColor;
        vertical-align: middle;
        width: 24px;
        height: 24px;
        display: inline-block;
      }
      .wt-nudge-b-1 {
        bottom: 1px !important;
      }
      .occasion-title {
        letter-spacing: 0.09px;
        font-size: 18px;
        font-weight: 500;
        line-height: 1.35;
        white-space: normal !important;
      }
      @media only screen and (min-width: 640px) {
        .occasion-title {
          letter-spacing: 0.09505px;
          font-size: 19.01px;
          font-weight: 500;
          line-height: 1.4;
        }
      }
      .clip-image-container {
        border-radius: 0 0 10px 10px;
        overflow: hidden;
      }
      .clip-image-ellipse {
        -webkit-clip-path: circle(58% at 77% 60%);
        clip-path: circle(58% at 77% 60%);
        position: relative;
      }
      .wt-image {
        background-color: #eaeaea;
        width: 100%;
      }
      .clip-image-ellipse img {
        object-fit: cover;
        transition: transform 0.15s ease-out;
        display: block;
      }
      .wt-image.wt-image--cover {
        object-fit: cover;
      }
      .occasion-card {
        height: 100%;
        aspect-ratio:1;
      }
   @media only screen and (max-width: 768px) {
         .clip-image-ellipse {
        -webkit-clip-path: circle(60% at 60% 60%);
        clip-path: circle(60% at 60% 60%);
      }
     .wt-text-truncate--multi-line{
       margin-top:4px;
     }
     .occasion-card-item{
       padding:6px 8px 0px 8px;
     }
   }
     .section-{{ section.id }}-block {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-block {
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

.tw-grid--block {
    margin: -14px;
}
 .tw-swiper-button svg {
      width: 24px;
      height: 24px;
      fill: #000;
    }
    .tw-swiper-button{
      background-color: #fff;
      opacity: 1;
      box-shadow: var(--clg-effect-sem-shadow-elevation-3, 0px 1px 3px 0px #0000004d, 0px 4px 8px 3px #00000026);
       transition: backgroundColor .2s cubic-bezier(.345,.115,.135,1.42), opacity .15s ease-out;
    }
    .tw-swiper-button:hover{
      opacity: 0.8;
      background-color: #f5f5f5;
    }

  </style>
<div class="tw-px-1.5 section-{{ section.id }}-block">
  <div class="tw-mx-auto tw-max-w-[1400px] tw-px-1.5">
    <div class="tw-flex tw-justify-between tw-items-center tw-mb-[18px]">
      {% if section.settings.title %}
        <h2 class="tw-text-[27px] tw-leading-[1.3] tw-font-medium tw-text-left md:tw-text-center">
          {{ section.settings.title | escape }}
        </h2>
      {% endif %}
      <div> 
        <div class="tw-hidden md:tw-flex tw-justify-center tw-items-center tw-gap-3 tw-text-[#222]">
          <button
            class="tw-swiper-left tw-swiper-button tw-w-12 tw-h-12 tw-rounded-full tw-flex tw-justify-center tw-items-center tw-cursor-pointer tw-shadow-lg">
            <span class="wt-icon wt-nudge-t-2">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path
                  d="M16 21.002a1 1 0 0 1-.664-.253L5.5 12.002l9.841-8.748a1 1 0 0 1 1.328 1.494L8.5 12.002l8.159 7.252A1 1 0 0 1 16 21.002">
                </path> 
              </svg>
            </span>
          </button>
          <button class="tw-swiper-right tw-swiper-button tw-w-12 tw-h-12 tw-rounded-full tw-flex tw-justify-center tw-items-center tw-cursor-pointer tw-shadow-lg">
            <span class="wt-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path
                  d="M8 21a1 1 0 0 1-.664-1.747l8.164-7.254-8.164-7.252a1 1 0 0 1 1.328-1.494L18.5 12l-9.836 8.747A1 1 0 0 1 8 21">
                </path>
              </svg>
            </span>
          </button>
        </div>
      </div>
    </div>
    <div class="tw-pt-4 tw-px-1.5 gift_swiper swiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          {% if block.settings.link or block.settings.image or block.settings.title or block.settings.date %}
            <div class="swiper-slide">
              {% if block.settings.link %}
                <a
                  href="{{ block.settings.link | escape }}"
                  rel="nofollow"
                  target="_blank"
                  class="tw-p-[9px] occasion-link tw-block tw-rounded-xl tw-overflow-clip tw-relative tw-z-0 tw-text-[#222]" {{ block.shopify_attributes }}>
              {% else %}
                <div class="tw-p-[9px] occasion-link tw-block tw-rounded-xl tw-overflow-clip tw-relative tw-z-0 tw-text-[#222]" {{ block.shopify_attributes }}>
              {% endif %}
                <div
                  class="occasion-card tw-flex tw-relative tw-flex-col tw-rounded-2xl tw-p-1.5 tw-justify-between"
                  {% if block.settings.bg_color %}style="background-color: {{ block.settings.bg_color | escape }};"{% endif %}
                >
                  <div class="tw-px-1.5 tw-py-3 occasion-card-item">
                    <div class="tw-text-[#222]">
                      {% if block.settings.date and block.settings.badge_color %}
                        <span
                          class="tw-inline-block tw-rounded-[20px] tw-px-1.5 tw-py-0.5 tw-font-normal tw-text-[13px] tw-leading-[1.4] tw-tracking-[0.1299px]"
                          style="background-color: {{ block.settings.badge_color | escape }};"
                        >
                          <span
                            class="wt-icon wt-icon--smaller wt-nudge-b-1 tw-relative"
                          >
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              viewBox="0 0 24 24"
                              aria-hidden="true"
                              focusable="false"
                            >
                              <path
                                d="M17.5 16a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0"
                              ></path>
                              <path
                                fill-rule="evenodd"
                                clip-rule="evenodd"
                                d="M6.5 5H3v16h18V5h-3.5V3h-2v2h-7V3h-2zm0 2v1h2V7h7v1h2V7H19v3H5V7zM5 12v7h14v-7z"
                              ></path>
                            </svg>
                          </span>
                          {{ block.settings.date | escape }}
                        </span>
                      {% endif %}
                    </div>
                    {% if block.settings.title %}
                      <p
                        class="wt-text-truncate--multi-line wt-wrap occasion-title wt-mt-xs-2 tw-mt-3"
                      >
                        {{ block.settings.title | escape }}
                      </p>
                    {% endif %}
                  </div>
                  <div class="clip-image-container">
                    <div class="clip-image-ellipse">
                      {% if block.settings.image != blank %}
                        {{ block.settings.image | image_url: width: 600 | image_tag: widths: '200,300, 600',
                          class: 'wt-width-full wt-image--cover wt-image',
                          loading: 'lazy'
                        }}
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% if block.settings.link %}
                </a>
              {% else %}
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>
 <script>
    var gift_swiper = new Swiper(".gift_swiper", {
            slidesPerView: '1.7',
            spaceBetween: 0,
            // 如果需要前进后退按钮
            navigation: {
                nextEl: '.tw-swiper-right',
                prevEl: '.tw-swiper-left',
            },       
            breakpoints: {
                768: {
                    slidesPerView: 3,
                    spaceBetween: 0,
                },
                1024: { // 屏幕宽度 <= 640px
                    slidesPerView: 4,
                    spaceBetween: 0,
                }

            },
        });

    </script>
{% schema %}
{
  "name": "Custom 礼品",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Shop gifts perfect for the occasion!"
    }, {
      "type": "header",
      "content": "外边距"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "top",
      "default": 24
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "bottom",
      "default": 0
    }, {
      "type": "header",
      "content": "内边距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "occasion_card",
      "name": "Occasion Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Occasion Title",
          "default": "Easter"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "Apr 20"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Card Background Color",
          "default": "#fdd95c"
        },
        {
          "type": "color",
          "id": "badge_color",
          "label": "Badge Background Color",
          "default": "#ccebff"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom 礼品",
      "blocks": [
        {
          "type": "occasion_card"
        },
        {
          "type": "occasion_card"
        },
        {
          "type": "occasion_card"
        },
        {
          "type": "occasion_card"
        }
      ]
    }
  ]
}
{% endschema %}