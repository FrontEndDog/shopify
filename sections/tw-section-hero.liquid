 <style>
    .shoppable-hero-headline__image--spotlighted {
      -webkit-clip-path: circle(farthest-side at 50% 100%);
      clip-path: circle(farthest-side at 50% 100%);
      position: relative;
    }
    @media only screen and (min-width: 640px) {
      .shoppable-hero-headline__image--spotlighted {
        -webkit-clip-path: circle(farthest-side at 100%);
        clip-path: circle(farthest-side at 100%);
        position: relative;
      }
    }
    .tw-bg-box {
      background: linear-gradient(#0e0e0e00 48%, #0e0e0eab 100%);
    }
   .shoppable-hero--two-column img {
    max-height: 400px !important;
}
    
     .section-{{ section.id }}-block {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-block {
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  </style>
<div class="section-{{ section.id }}-block">
  <div class="tw-mx-auto tw-max-w-[1400px] tw-px-1.5">
    <div class="tw-flex">
      <div class="tw-w-full tw-flex-1 tw-flex tw-gap-[30px] shoppable-hero">
        <!-- Main Hero Card -->
        <div class="tw-relative tw-flex tw-rounded-xl tw-z-10 tw-flex-1 shoppable-hero--two-column tw-shadow">
          {% if section.settings.main_button_link %}
            <a href="{{ section.settings.main_button_link | escape }}" class="tw-absolute tw-inset-0 tw-z-10"></a>
          {% endif %}
          <div class="tw-w-full">
            <div class="tw-flex tw-flex-col md:tw-flex-row tw-bg-[#8C8AF0] tw-rounded-xl tw-overflow-hidden tw-h-full" style="background-color:{{ section.settings.bg_color }}">
              <div class="shoppable-hero-headline__content tw-p-6 md:tw-basis-1/2 tw-flex tw-flex-col tw-gap-1 tw-items-center tw-justify-center tw-text-center tw-text-black">
                {% if section.settings.main_title %}
                  <p id="shoppable-hero-title" class="tw-text-display tw-text-4xl md:tw-text-5xl">
                    {{ section.settings.main_title | escape }}
                  </p>
                {% endif %}
                {% if section.settings.main_description %}
                  <p class="tw-text-title-large tw-text-lg">
                    {{ section.settings.main_description | escape }}
                  </p>
                {% endif %}
                {% if section.settings.main_button_link and section.settings.main_button_text %}
                  <a href="{{ section.settings.main_button_link | escape }}" type="button" class="tw-hidden md:tw-block tw-px-[18px] tw-py-3 tw-mt-3 tw-min-h-12 tw-text-base tw-relative tw-rounded-3xl tw-bg-[#222] tw-text-white tw-btn--primary">
                    {{ section.settings.main_button_text | escape }}
                  </a>
                {% endif %}
              </div>
              <div class="shoppable-hero-headline__image shoppable-hero-headline__image--spotlighted tw-flex-1">
                {% if section.settings.main_image != blank %}
                  {{ section.settings.main_image | image_url: width: 1360 | image_tag: widths: '680, 850,1020,1190,1360',
                    class: 'tw-height-full tw-object-fit-cover tw-image tw-max-h-[400px] tw-w-full tw-object-cover tw-h-full tw-overflow-visible',
                    loading: 'lazy'
                  }}
                {% endif %}
                {% if section.settings.main_button_link and section.settings.main_button_text %}
                  <a href="{{ section.settings.main_button_link | escape }}" type="button" class="tw-block tw-absolute tw-bottom-3 tw-left-1/2 -tw-translate-x-1/2 md:tw-hidden tw-px-[18px] tw-py-3 tw-mt-3 tw-min-h-12 tw-text-base tw-rounded-3xl tw-bg-[#222] tw-text-white">
                    {{ section.settings.main_button_text | escape }}
                  </a>
                {% endif %}
              </div>
            </div>
          </div>
        </div>

        <!-- Secondary Card (Hidden on Mobile) -->
        <div class="tw-max-w-[400px] tw-max-h-[400px] tw-w-full tw-hidden md:tw-block">
          <div class="tw-flex-1 tw-max-w-[400px] tw-max-h-[400px]">
            <div class="tw-grid tw-grid-cols-1 tw-h-full tw-rounded-xl">
              <div class="shoppable-hero-page__item--primary-gradient tw-rounded-xl tw-shadow tw-flex tw-flex-col tw-justify-end tw-relative tw-cursor-pointer tw-text-balance">
                {% if section.settings.secondary_link %}
                  <a class="tw-absolute tw-inset-0 tw-z-10 tw-bg-box tw-rounded-xl" href="{{ section.settings.secondary_link | escape }}" aria-label="{{ section.settings.secondary_title | escape }}"></a>
                {% endif %}
                {% if section.settings.secondary_image != blank %}
                  {{ section.settings.secondary_image | image_url: width: 800 | image_tag: widths: '600, 800', class: 'tw-object-cover tw-relative tw-bg-[#eaeaea] tw-rounded-xl tw-h-full tw-max-h-[400px] tw-block', loading: 'lazy' }}
                {% endif %}
                <div class="tw-absolute tw-px-[18px] tw-pb-[18px] tw-w-full tw-z-20">
                  {% if section.settings.secondary_title %}
                    <p class="tw-text-white md:tw-text-[27px] md:tw-leading-[1.3] tw-text-2xl tw-font-medium">
                      {{ section.settings.secondary_title | escape }}
                    </p>
                  {% endif %}
                  {% if section.settings.secondary_button_text %}
                    <span class="tw-text-white tw-text-base">
                      {{ section.settings.secondary_button_text | escape }}
                    </span>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Custom 图文横幅",
  "settings": [
    {
      "type": "text",
      "id": "main_title",
      "label": "Main Title",
      "default": "Best birthday yet!"
    },
    {
      "type": "text",
      "id": "main_description",
      "label": "Main Description",
      "default": "Give gifts that say, “I get you.”"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    },
    {
      "type": "text",
      "id": "main_button_text",
      "label": "Main Button Text",
      "default": "Shop special"
    },
    {
      "type": "url",
      "id": "main_button_link",
      "label": "Main Button Link"
    },
    {
      "type": "text",
      "id": "secondary_title",
      "label": "Secondary Title",
      "default": "Great deals from small shops"
    },
    {
      "type": "text",
      "id": "secondary_button_text",
      "label": "Secondary Button Text",
      "default": "Shop Now"
    },
    {
      "type": "image_picker",
      "id": "secondary_image",
      "label": "Secondary Image"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary Link"
    },
     {
      "type": "header",
      "content": "背景色"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "backgroung color",
      "default": "#8C8AF0"
    },
     {
      "type": "header",
      "content": "外边距"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "top",
      "default": 24
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "bottom",
      "default": 0
    }, {
      "type": "header",
      "content": "内边距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Custom 图文横幅"
    }
  ]
}
{% endschema %}